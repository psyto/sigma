# Solana RPC
RPC_URL=https://api.devnet.solana.com

# Solver
SOLVER_KEYPAIR_PATH=~/.config/solana/id.json
POLL_INTERVAL_MS=30000
MAX_SLIPPAGE_BPS=50
API_PORT=3001

# Frontend (Next.js)
# Copy these to frontend/.env.local
NEXT_PUBLIC_SOLANA_NETWORK=localnet
NEXT_PUBLIC_SHARED_ORACLE_PROGRAM_ID=
NEXT_PUBLIC_VOLSWAP_PROGRAM_ID=
NEXT_PUBLIC_FUNDING_SWAP_PROGRAM_ID=
NEXT_PUBLIC_EXOTIC_VAULT_PROGRAM_ID=
