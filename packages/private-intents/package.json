{
  "name": "@sigma-protocol/private-intents",
  "version": "0.1.0",
  "description": "Private cross-chain intent protocol for Sigma derivatives",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
